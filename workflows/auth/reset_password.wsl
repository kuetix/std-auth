workflow reset_password {
  start: ExtractToken

  state ExtractToken {
    action services/auth/jwt.ExtractTokenFromHeader(
      authHeader: $args.authorization
    ) as TokenResult
    on success -> ValidateToken
    on error -> AuthenticationFailed
  }

  state ValidateToken {
    action services/auth/jwt.ValidateToken(
      tokenString: $TokenResult.response.token
    ) as UserInfo
    on success -> ValidateInput
    on error -> AuthenticationFailed
  }

  state ValidateInput {
    action services/common/assert.NotEmpty(
      value: $args.email,
      message: "Email is required"
    ) as EmailCheck
    on success -> ValidatePassword
    on error -> ValidationFailed
  }

  state ValidatePassword {
    action services/common/assert.NotEmpty(
      value: $args.newPassword,
      message: "New password is required"
    ) as PasswordCheck
    on success -> ResetUserPassword
    on error -> ValidationFailed
  }

  state ResetUserPassword {
    action services/auth/user.ResetPassword(
      email: $args.email,
      newPassword: $args.newPassword,
      requestingUserEmail: $UserInfo.response.email
    ) as ResetResult
    on success -> FormatResponse
    on error -> ResetFailed
  }

  state FormatResponse {
    action services/common/response.Response(
      value: {
        message: $ResetResult.response.message,
        email: $ResetResult.response.email
      },
      statusCode: 200
    ) as Response
    end ok
  }

  state ValidationFailed {
    action services/common/response.Response(
      value: {error: $error.message},
      statusCode: 400
    ) as ErrorResponse
    end fail
  }

  state AuthenticationFailed {
    action services/common/response.Response(
      value: {error: $error.message},
      statusCode: 401
    ) as ErrorResponse
    end fail
  }

  state ResetFailed {
    action services/common/response.Response(
      value: {error: $error.message},
      statusCode: 403
    ) as ErrorResponse
    end fail
  }
}
